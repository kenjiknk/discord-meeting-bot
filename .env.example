DISCORD_TOKEN=seu_token_aqui

# Whisper: tiny, base, small, medium, large-v3
# large-v3 recomendado para este hardware (Ryzen 5 7535U, 30GB RAM)
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=pt

# ID do canal onde a transcrição e o .jsonl serão postados
# (botão direito no canal → Copiar ID — requer Developer Mode ativado)
SUMMARY_CHANNEL_ID=

# Para sync instantâneo de slash commands durante desenvolvimento
# (sem isso, comandos globais podem levar até 1h para aparecer)
TEST_GUILD_ID=

# Salva .wav por participante após a reunião (true/false)
SAVE_WAV=false
